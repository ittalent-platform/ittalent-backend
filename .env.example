PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/express_template?replicaSet=rs0
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OPENAPI_SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
REDIS_URL=redis://127.0.0.1:6379
APP_BASE_URL=http://localhost:5173
WEB_URL=http://localhost:5173

# Brevo Email
# BREVO_API_KEY=xkeysib-your-rest-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=ITTalent

# Auth Token Windows
EMAIL_VERIFICATION_WINDOW_MS=86400000
RESET_PASSWORD_TOKEN_WINDOW_SECONDS=3600
RESET_TOKEN_HISTORY_GRACE_SECONDS=3600
AUTH_VERIFICATION_JOB_INTERVAL_MS=3600000

# Rate Limits
LOGIN_RATE_LIMIT_WINDOW_MS=60000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
RESET_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
RESET_PASSWORD_TOKEN_CHECK_RATE_LIMIT_WINDOW_SECONDS=900
RESET_PASSWORD_TOKEN_CHECK_RATE_LIMIT_MAX_ATTEMPTS=10
RESEND_VERIFICATION_EMAIL_RATE_LIMIT_WINDOW_SECONDS=86400
RESEND_VERIFICATION_EMAIL_RATE_LIMIT_MAX_ATTEMPTS=3
VERIFICATION_ATTEMPT_RATE_LIMIT_WINDOW_SECONDS=600
VERIFICATION_ATTEMPT_RATE_LIMIT_MAX_ATTEMPTS=5

# Admin Account Seeding (npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123456!
